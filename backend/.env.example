# SQLite works out of the box for local development / the hackathon demo.
DATABASE_URL=sqlite:///./dhan.db
# For PostgreSQL (recommended for anything beyond local demo use), comment the
# line above and uncomment this one instead:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dhan

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE=5242880
OCR_TESSERACT_ENABLED=false
